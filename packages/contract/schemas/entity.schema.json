{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.platform/schema/entity.json",
  "title": "Entity",
  "description": "业务实体及其属性。",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "semantic.platform/v1" },
    "kind": { "const": "Entity" },
    "metadata": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryKey", "attributes"],
      "properties": {
        "primaryKey": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
              "type": {
                "enum": ["string", "number", "integer", "boolean", "date", "datetime"]
              },
              "description": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
