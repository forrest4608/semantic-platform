{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.platform/schema/eval-case.json",
  "title": "EvalCase",
  "description": "独立存放的黄金评测用例。也可以嵌在 CasePack.spec.cases 里。",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "semantic.platform/v1" },
    "kind": { "const": "EvalCase" },
    "metadata": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "expectedAnswer", "expectedObjects", "golden"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "expectedAnswer": { "type": "string", "minLength": 1 },
        "expectedObjects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/id" }
        },
        "golden": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
