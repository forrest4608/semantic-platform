{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.platform/schema/policy.json",
  "title": "Policy",
  "description": "访问策略。condition 是作者文本，M0 不执行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "semantic.platform/v1" },
    "kind": { "const": "Policy" },
    "metadata": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "subjects", "resources", "operations"],
      "properties": {
        "effect": { "enum": ["allow", "deny"] },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["role", "user", "group"] },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/id" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["read", "write", "invoke"] }
        },
        "condition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
