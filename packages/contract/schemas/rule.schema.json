{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.platform/schema/rule.json",
  "title": "Rule",
  "description": "可按业务发生时点查询的规则。写明计算基准、生效日、废止日，以及替代了哪一版、被哪一版替代。",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "semantic.platform/v1" },
    "kind": { "const": "Rule" },
    "metadata": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "citation", "basis", "subjectTypes", "evidence"],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "description": "同一主题的现行版本与已废止版本会被证据检索一起召回，再按是否现行标注。"
        },
        "citation": { "type": "string", "minLength": 1 },
        "basis": {
          "enum": ["working_day", "calendar_day"],
          "description": "working_day 为工作日；calendar_day 为自然日。"
        },
        "subjectTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "effectiveFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "生效日。缺省表示材料没有写生效日，查询时不因此判为未生效。"
        },
        "supersededAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "废止日。从该日起不再作为计算依据。"
        },
        "replaces": {
          "$ref": "https://semantic.platform/schema/defs.json#/$defs/id",
          "description": "本规则替代了哪一版。"
        },
        "replacedBy": {
          "$ref": "https://semantic.platform/schema/defs.json#/$defs/id",
          "description": "本规则被哪一版替代。"
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comparison", "value", "unit"],
          "properties": {
            "comparison": { "const": "gt" },
            "value": { "type": "number" },
            "unit": { "enum": ["working_day", "calendar_day"] }
          }
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "per", "unit"],
          "properties": {
            "amount": { "type": "number" },
            "per": { "const": "person" },
            "unit": { "enum": ["working_day", "calendar_day"] },
            "currency": { "type": "string", "minLength": 1 }
          }
        },
        "includeEndpoints": {
          "type": "boolean",
          "description": "为 true 时出发日和返回日都计入。"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "excerpt"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "excerpt": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
