{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.platform/schema/scenario-brief.json",
  "title": "ScenarioBrief",
  "description": "场景简报。记录由业务场景描述整理出的需求目标 G[]。",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "semantic.platform/v1" },
    "kind": { "const": "ScenarioBrief" },
    "metadata": { "$ref": "https://semantic.platform/schema/defs.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goals"],
      "properties": {
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^G[1-9][0-9]*$",
                "description": "需求目标编号，形如 G1、G2。"
              },
              "statement": { "type": "string", "minLength": 1 },
              "priority": { "enum": ["must", "should", "could"] }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "支撑这些目标的材料名称。不是物理映射。"
        }
      }
    }
  }
}
